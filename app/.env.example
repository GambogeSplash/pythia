# ── Database (Neon Serverless Postgres) ──
DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/pythia?sslmode=require"

# ── NextAuth ──
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3001"

# ── Email (for magic link auth — optional, use Resend/Sendgrid/etc) ──
AUTH_RESEND_KEY=""

# ── OAuth providers (optional) ──
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
